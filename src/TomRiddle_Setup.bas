Attribute VB_Name = "TomRiddle_Setup"
' ===================================================================
'  Tom Riddle - Setup.  IMPORT this file (File > Import File), then F5
'  -> TomRiddle_Install.  Do NOT copy-paste into the code window.
'  All entries are FORMATTED AutoCorrect entries (AddRichText): boards
'  are real tables.  They live in Normal.dotm - the installer performs
'  a REAL NormalTemplate.Save at the end; without it NOTHING persists
'  after Word closes (plain entries added via automation never persist).
' ===================================================================
Option Explicit

Private tDoc As Document
Private tTbl As Table

Private Function U(ByVal codes As String) As String
    Dim parts As Variant
    Dim i As Long
    Dim s As String
    s = ""
    If Len(codes) = 0 Then
        U = ""
        Exit Function
    End If
    parts = Split(codes, " ")
    For i = LBound(parts) To UBound(parts)
        If Len(parts(i)) > 0 Then
            s = s & ChrW(CLng(parts(i)))
        End If
    Next i
    U = s
End Function

Private Sub AddRich(ByVal nm As String, ByVal rng As Range)
    ' delete in a loop: a plain and a rich entry can share the same name
    Dim t As Long
    On Error Resume Next
    For t = 1 To 8
        Err.Clear
        Application.AutoCorrect.Entries(nm).Delete
        If Err.Number <> 0 Then Exit For
    Next t
    Err.Clear
    Application.AutoCorrect.Entries.AddRichText nm, rng
    On Error GoTo 0
End Sub

Private Function StatusText(ByVal status As String) As String
    Select Case status
        Case "play"
            StatusText = U("1514 1493 1512 1498 33 32 32 58 41")
        Case "lose"
            StatusText = U("1504 1497 1510 1495 1514 1497 33 32 1502 1513 1495 1511 32 1496 1493 1489 46 32 32 58 41")
        Case "draw"
            StatusText = U("1514 1497 1511 1493 33 32 1502 1513 1495 1511 32 1510 1502 1493 1491 46 32 32 58 41")
        Case "win"
            StatusText = U("1504 1497 1510 1495 1514 33 32 1499 1500 32 1492 1499 1489 1493 1491 33 32 32 58 41")
    End Select
End Function

Private Sub AddChat(ByVal nm As String, ByVal val As String)
    Dim r As Range
    Set r = tDoc.Content
    r.End = r.End - 1
    r.Text = val
    AddRich nm, tDoc.Content
End Sub

Private Sub BoardDoc()
    ' NO ParagraphFormat calls here: on a windowless document they
    ' crash the Word process (see the CRASH RULE in the generator).
    tDoc.Content.Delete
    Set tTbl = tDoc.Tables.Add(tDoc.Range(0, 0), 3, 3)
    tTbl.Borders.InsideLineStyle = 1
    tTbl.Borders.OutsideLineStyle = 1
    tTbl.Rows.Alignment = 1
    tTbl.Rows.HeightRule = 2
    tTbl.Rows.Height = 26
    tTbl.Columns.Width = 20
    On Error Resume Next
    tTbl.LeftPadding = 2
    tTbl.RightPadding = 2
    On Error GoTo 0
    tTbl.Range.Cells.VerticalAlignment = 1
    tTbl.Range.Font.Size = 16
    tTbl.TableDirection = 1
    Dim sr As Range
    Set sr = tDoc.Paragraphs.Last.Range
    sr.Font.Bold = True
    sr.Font.Size = 12
End Sub

Private Sub SetCell(ByVal i As Long, ByVal ch As String)
    Dim r As Range
    Set r = tTbl.Cell((i - 1) \ 3 + 1, (i - 1) Mod 3 + 1).Range
    r.End = r.End - 1
    r.Text = ch
    Set r = tTbl.Cell((i - 1) \ 3 + 1, (i - 1) Mod 3 + 1).Range
    If ch = "X" Then
        r.Font.Bold = True
        r.Font.Color = 192
    ElseIf ch = "O" Then
        r.Font.Bold = True
        r.Font.Color = 12603392
    Else
        r.Font.Bold = False
        r.Font.Color = 9868950
    End If
End Sub

Private Sub SetBoard(ByVal raw As String, ByVal status As String)
    Dim i As Long, ch As String, sr As Range
    Set tTbl = tDoc.Tables(1)   ' re-fetch: table pointers can go stale
    For i = 1 To 9
        ch = Mid(raw, i, 1)
        If ch = " " Then ch = CStr(i)
        SetCell i, ch
    Next i
    Set sr = tDoc.Paragraphs.Last.Range
    sr.End = sr.End - 1
    sr.Text = StatusText(status)
End Sub

Private Sub G(ByVal key As String, ByVal raw As String, ByVal status As String)
    SetBoard raw, status
    AddRich U("1514 1514 1514") & key, tDoc.Content
End Sub

Public Sub TomRiddle_Install()
    ' NOTE: do NOT set ScreenUpdating = False - combined with an
    ' invisible document it reproducibly crashes Word (RPC failure).
    Set tDoc = Documents.Add(Visible:=False)
    InstallChat
    BoardDoc
    InstallGame1
    InstallGame2
    InstallGame3
    InstallGame4
    InstallGame5
    InstallGame6
    InstallGame7
    InstallGame8
    InstallAlias
    tDoc.Saved = True
    tDoc.Close 0
    Set tDoc = Nothing
    Dim i As Long, n As Long, p3 As String
    p3 = U("1514 1514 1514")
    For i = 1 To Application.AutoCorrect.Entries.Count
        If Left(Application.AutoCorrect.Entries(i).Name, 3) = p3 Then n = n + 1
    Next i
    ' REAL save - this is what makes the install survive Word closing
    On Error Resume Next
    NormalTemplate.Save
    On Error GoTo 0
    MsgBox U("1514 1493 1501 32 1512 1497 1491 1500 32 1502 1493 1499 1503 33 32 1504 1513 1502 1512 1493 32") & n & U("32 1500 1493 1495 1493 1514 32 1502 1513 1495 1511 46 32 32 58 41") & vbCr & U("1504 1505 1492 32 1489 1493 1493 1512 1491 58 32 32 1492 1497 1497 32 1510 1488 1496"), vbInformation, "Tom Riddle"
End Sub

