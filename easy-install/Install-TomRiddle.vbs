' Install-TomRiddle.vbs  -  double-click to install (no VBA editor needed).
Option Explicit
Dim word, createdWord
Function U(codes)
    Dim parts, i, s
    s = ""
    If Len(codes) = 0 Then
        U = ""
        Exit Function
    End If
    parts = Split(codes, " ")
    For i = 0 To UBound(parts)
        If Len(parts(i)) > 0 Then s = s & ChrW(CLng(parts(i)))
    Next
    U = s
End Function
On Error Resume Next
Set word = GetObject(, "Word.Application")
If word Is Nothing Then
    Set word = CreateObject("Word.Application")
    createdWord = True
End If
On Error GoTo 0
If word Is Nothing Then
    MsgBox "Microsoft Word not found.", 16, "Tom Riddle"
    WScript.Quit
End If
If createdWord Then word.Visible = False
Function CellCh(raw, i)
    Dim ch
    ch = Mid(raw, i, 1)
    If ch = " " Then
        CellCh = CStr(i)
    Else
        CellCh = ch
    End If
End Function
Function BoardText(raw, status)
    Dim r1, r2, r3, s, nl, L, P
    nl = ChrW(11)
    L = ChrW(8234)
    P = ChrW(8236)
    r1 = L & " " & CellCh(raw,1) & " | " & CellCh(raw,2) & " | " & CellCh(raw,3) & " " & P
    r2 = L & " " & CellCh(raw,4) & " | " & CellCh(raw,5) & " | " & CellCh(raw,6) & " " & P
    r3 = L & " " & CellCh(raw,7) & " | " & CellCh(raw,8) & " | " & CellCh(raw,9) & " " & P
    Select Case status
        Case "play"
            s = U("1514 1493 1512 1498 33 32 32 58 41")
        Case "lose"
            s = U("1504 1497 1510 1495 1514 1497 33 32 1502 1513 1495 1511 32 1496 1493 1489 46 32 32 58 41")
        Case "draw"
            s = U("1514 1497 1511 1493 33 32 1502 1513 1495 1511 32 1510 1502 1493 1491 46 32 32 58 41")
        Case "win"
            s = U("1504 1497 1510 1495 1514 33 32 1499 1500 32 1492 1499 1489 1493 1491 33 32 32 58 41")
    End Select
    BoardText = r1 & nl & r2 & nl & r3 & nl & s & nl
End Function
Sub AddP(nm, val)
    On Error Resume Next
    word.AutoCorrect.Entries.Add nm, val
    On Error GoTo 0
End Sub
Sub AddG(key, raw, status)
    AddP U("1514 1514 1514") & key, BoardText(raw, status)
End Sub
