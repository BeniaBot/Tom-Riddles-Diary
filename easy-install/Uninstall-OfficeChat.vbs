' Uninstall-OfficeChat.vbs  -  double-click to uninstall (no VBA editor needed).
Option Explicit
Dim word, createdWord
Function U(codes)
    Dim parts, i, s
    s = ""
    If Len(codes) = 0 Then
        U = ""
        Exit Function
    End If
    parts = Split(codes, " ")
    For i = 0 To UBound(parts)
        If Len(parts(i)) > 0 Then s = s & ChrW(CLng(parts(i)))
    Next
    U = s
End Function
On Error Resume Next
Set word = GetObject(, "Word.Application")
If word Is Nothing Then
    Set word = CreateObject("Word.Application")
    createdWord = True
End If
On Error GoTo 0
If word Is Nothing Then
    MsgBox "Microsoft Word not found.", 16, "OfficeChat"
    WScript.Quit
End If
If createdWord Then word.Visible = False
Sub DelE(nm)
    On Error Resume Next
    word.AutoCorrect.Entries(nm).Delete
    On Error GoTo 0
End Sub
